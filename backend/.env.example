APP_ENV=development
DATABASE_URL=postgresql+psycopg2://fithayot:fithayot@localhost:5432/fithayot360
# Productionda albatta uzun tasodifiy qiymat qo'ying: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# Toshkent vaqti UTC+5 -> 300 daqiqa (haftalik statistikada kunlarni ajratish uchun)
APP_TZ_OFFSET_MINUTES=300
CORS_ORIGINS=*
# Faqat development: parol tiklash tokenini javobda qaytaradi (email xizmati ulanmaguncha)
EXPOSE_RESET_TOKEN=true
AUTO_CREATE_TABLES=true
SEED_ON_START=true
# Kontent administratori (seed paytida yaratiladi)
ADMIN_EMAIL=admin@fithayot.uz
ADMIN_PASSWORD=ChangeMe123
